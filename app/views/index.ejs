<!DOCTYPE html>
<html lang="en">
   <head>
       <meta charset="UTF-8">
       <meta name="viewport" content="width=device-width, initial-scale=1.0">
       <title>Document</title>
       <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&amp;family=Geist:wght@100..900&amp;display=swap" rel="stylesheet">
       <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
       <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
       <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous" defer></script>


   <style>
       * {
           font-family: "Geist";
       }
   </style>
   </head>
   <body>
            <h1 class="my-9 text-center">Pokemon Legendary Detector</h1>

           <section class="my-9 d-flex flex-row justify-content-center" style="gap: 100px">
                

                <form class="d-flex flex-column gap-1" method="post" action="/predict">
                    <h3>Input your pokemon's thingies</h3>
                    <div class="d-flex flex-column mt-5">
                        <label for="hp" class="form-label">HP</label>
                        <div class="form-range">
                            <input type="number" class="form-control" id="hp" name="hp" min="1" max="255">
                        </div>
                    </div>

                    <div class="d-flex flex-column mt-5">
                        <label for="attack" class="form-label">Attack</label>
                        <div class="form-range">
                            <input type="number" class="form-control" id="attack" name="attack" min="1" max="255">
                        </div>
                    </div>

                    <div class="d-flex flex-column mt-5">
                        <label for="defense" class="form-label">Defense</label>
                        <div class="form-range">
                            <input type="number" class="form-control" id="defense" name="defense" min="1" max="255">
                        </div>
                    </div>

                    <div class="d-flex flex-column mt-5">
                        <label for="spAtk" class="form-label">Sp. Attack</label>
                        <div class="form-range">
                            <input type="number" class="form-control" id="spAtk" name="spAtk" min="1" max="255">
                        </div>
                    </div>

                    <div class="d-flex flex-column mt-5">
                        <label for="spDef" class="form-label">Sp. Defense</label>
                         <div class="form-range">
                            <input type="number" class="form-control" id="spDef" name="spDef" min="1" max="255">
                        </div>
                    </div>

                    <div class="d-flex flex-column mt-5">
                        <label for="speed" class="form-label">Speed</label>
                        <div class="form-range">
                            <input type="number" class="form-control" id="speed" name="speed" min="1" max="255">
                        </div>
                    </div>

                    <div class="d-flex flex-column mt-5">
                        <label for="type1" class="form-label">Primary type</label>
                        <div class="form-range">
                            <select class="form-control" id="type1" name="type1" required>
                                <option>Bug</option>
                                <option>Dark</option>
                                <option>Dragon</option>
                                <option>Electric</option>
                                <option>Fairy</option>
                                <option>Fighting</option>
                                <option>Fire</option>
                                <option>Flying</option>
                                <option>Ghost</option>
                                <option>Grass</option>
                                <option>Ground</option>
                                <option>Ice</option>
                                <option>Normal</option>
                                <option>Poison</option>
                                <option>Psychic</option>
                                <option>Rock</option>
                                <option>Steel</option>
                                <option>Water</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex flex-column mt-5">
                        <label for="type2" class="form-label">Secondary type</label>
                        <div class="form-range">
                            <select class="form-control" id="type2" name="type2" required>
                                <option>None</option>
                                <option>Bug</option>
                                <option>Dark</option>
                                <option>Dragon</option>
                                <option>Electric</option>
                                <option>Fairy</option>
                                <option>Fighting</option>
                                <option>Fire</option>
                                <option>Flying</option>
                                <option>Ghost</option>
                                <option>Grass</option>
                                <option>Ground</option>
                                <option>Ice</option>
                                <option>Normal</option>
                                <option>Poison</option>
                                <option>Psychic</option>
                                <option>Rock</option>
                                <option>Steel</option>
                                <option>Water</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex flex-column mt-5">
                        <label for="gen" class="form-label">Generation</label>
                        <div class="form-range">
                            <select class="form-control" id="gen" name="generation" required>
                                <option>1</option>
                                <option>2</option>
                                <option>3</option>
                                <option>4</option>
                                <option>5</option>
                                <option>6</option>
                            </select>
                        </div> 
                    </div>

                    <button type="submit" class="mt-4 btn btn-solid theme-accent">Analyze my Pokemon</button>
                </form>

                <div class="d-flex flex-column gap-4">
                    <h3>Pokemon results</h3>
                    <p></p>
                    <% const vote = (v) => {
                        const yes = v === true || v === 1 || String(v).toLowerCase() === 'true';
                        return yes
                            ? '<span class="ms-auto d-inline-flex align-items-center gap-1 px-3 py-1" style="border-radius:999px;background:#e6f6ec;color:#1a7f3c;font-weight:600;font-size:.9rem">&#10003; Legendary</span>'
                            : '<span class="ms-auto d-inline-flex align-items-center gap-1 px-3 py-1" style="border-radius:999px;background:#f0f1f3;color:#6b7280;font-weight:600;font-size:.9rem">&#10007; Not legendary</span>';
                    }; %>
                    <% if (locals.result?.votes) {%>
                    <section class="card" style="max-width: 100%">
                        <div class="card-body">
                            <div class="d-flex flex-row">
                                <h4 class="card-title my-0">Logistic Regression</h4>
                                <%- vote(result.votes.logreg) %>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="d-flex flex-row">
                                <h4 class="card-title my-0">SVC</h4>
                                <%- vote(result.votes.svm) %>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="d-flex flex-row">
                                <h4 class="card-title my-0">k-Neighbors</h4>
                                <%- vote(result.votes["k-neighbors"]) %>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="d-flex flex-row">
                                <h4 class="card-title my-0">Random Forest</h4>
                                <%- vote(result.votes.rfc) %>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="d-flex flex-row">
                                <h4 class="card-title my-0">Balanced Random Forest</h4>
                                <%- vote(result.votes.brf) %>
                            </div>
                        </div>
                    </section>
                    <% } else { %>
                    <section class="card" style="max-width: 100%">
                        <div class="card-body">
                            <div class="d-flex flex-row">
                                <h4 class="card-title my-0">Logistic Regression</h4>
                                <p class="ms-auto mb-0" style="min-width: 80px; min-height: 1.5em; border: 1px solid #ccc; border-radius: 4px"></p>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="d-flex flex-row">
                                <h4 class="card-title my-0">SVC</h4>
                                <p class="ms-auto mb-0" style="min-width: 80px; min-height: 1.5em; border: 1px solid #ccc; border-radius: 4px"></p>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="d-flex flex-row">
                                <h4 class="card-title my-0">k-Neighbors</h4>
                                <p class="ms-auto mb-0" style="min-width: 80px; min-height: 1.5em; border: 1px solid #ccc; border-radius: 4px"></p>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="d-flex flex-row">
                                <h4 class="card-title my-0">Random Forest</h4>
                                <p class="ms-auto mb-0" style="min-width: 80px; min-height: 1.5em; border: 1px solid #ccc; border-radius: 4px"></p>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="d-flex flex-row">
                                <h4 class="card-title my-0">Balanced Random Forest</h4>
                                <p class="ms-auto mb-0" style="min-width: 80px; min-height: 1.5em; border: 1px solid #ccc; border-radius: 4px"></p>
                            </div>
                        </div>
                    </section>
                    <% } %>
                    <section class="card" style="max-width: 100%">
                        <div class="card-body">
                            <h3 class="card-title">Results</h3>
                            <p class="card-text">Probability of legendary:</p>
                            <div class="progress" role="progressbar" aria-label="Basic example" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                                <% if (locals.result?.probability) { %>
                                    <div class="progress-bar" style="width: <%- result.probability * 100 %>%"><%= Math.round(result.probability * 100) %>%</div>
                                <% } else { %>
                                    <div class="progress-bar" style="width: 0%"></div>
                                <% } %>
                            </div>
                        </div>
                    </section>

                    <% if (locals.scores) { %>
                    <section class="card" style="max-width: 100%">
                        <div class="card-body">
                            <h3 class="card-title">Training metrics</h3>
                            <p class="card-text">Measured on the test set when the models were trained.</p>
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Model</th>
                                        <th>Accuracy</th>
                                        <th>F1</th>
                                        <th>Recall</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% const names = { "logreg": "Logistic Regression", "svm": "SVC", "k-neighbors": "k-Neighbors", "rfc": "Random Forest", "brf": "Balanced Random Forest" }; %>
                                    <% const best = Object.keys(scores).reduce((a, b) => scores[a].F1 >= scores[b].F1 ? a : b); %>
                                    <% for (const [key, m] of Object.entries(scores)) { %>
                                    <tr class="<%= key === best ? 'fw-bold' : '' %>">
                                        <td>
                                            <%= names[key] || key %>
                                            <% if (key === best) { %><span class="badge theme-success">Best</span><% } %>
                                        </td>
                                        <td><%= (m.Accu * 100).toFixed(1) %>%</td>
                                        <td><%= (m.F1 * 100).toFixed(1) %>%</td>
                                        <td><%= (m.Recall * 100).toFixed(1) %>%</td>
                                    </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </section>
                    <% } %>
                </div>
           </section>
   </body>
</html>

